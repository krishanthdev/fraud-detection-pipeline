# Copy this file to .env and fill in what you need. The real .env is gitignored.
# Nothing here is required for the default local run.

# Where MLflow stores runs. The default is a local sqlite file in the repo root.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Where the Streamlit app looks for the scoring API.
# Docker compose overrides this with the service name, http://api:8000
API_BASE_URL=http://localhost:8000

# Optional. Only needed if you download the data with the Kaggle API instead of by hand.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Overrides the repository root. The Docker image sets this. Leave it empty locally.
FRAUD_PIPELINE_ROOT=
