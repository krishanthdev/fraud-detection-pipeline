!data/**/README.md

# Model artifacts. Tracked in MLflow, not in git.
models/*
!models/.gitkeep

# MLflow local store
mlruns/
mlartifacts/
mlflow.db

# Generated reports. Figures used by the README are force added on purpose.
reports/tables/*
!reports/tables/.gitkeep
reports/*.log

