# Data. Nothing raw or derived is ever committed.
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep
!data/**/README.md

# Model artifacts. Tracked in MLflow, not in git.
models/*
!models/.gitkeep

# MLflow local store
mlruns/
mlartifacts/
mlflow.db

# Generated reports. Figures are committed, because the README shows them.
reports/tables/*
!reports/tables/.gitkeep
# These are committed deliberately. They are small, they change only when the data or the
# rules change, and they are the record of what was true on the run that produced the
# results. A reader should be able to see them without downloading 144 MB first.
!reports/tables/validation_report.md
!reports/tables/eda_report.md
!reports/tables/feature_selection.md
!reports/tables/feature_stats.csv
!reports/tables/feature_engineering.md
!reports/tables/engineered_feature_stats.csv
!reports/tables/evaluation.md
!reports/tables/evaluation_summary.json
!reports/tables/threshold_sensitivity.csv
!reports/tables/explanations.md
!reports/tables/shap_importance.csv
!reports/tables/registry.md
!reports/tables/feature_selection_engineered.md
!reports/tables/baseline_results.md
!reports/tables/baseline_results.csv
!reports/tables/baseline_summary.json
reports/*.log

